# Fictional development settings. Never put production credentials here.
# APP_ENV: development | test | production (default: development).
APP_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=example_development
# Comma-separated origins. Wildcard is development-only.
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=INFO
# Tests: explicitly set APP_ENV=test, a single loopback MONGO_URL,
# DB_NAME=test_example and explicit CORS_ORIGINS; real .env is not loaded.
# Production: set every variable via protected process environment;
# use explicit origins and a DB_NAME that does not identify a test database.
