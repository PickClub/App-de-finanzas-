# EAS reads this file from the Git repository root, above the Expo project.
# Deny all unrelated repository content; upload only the reviewed frontend inputs.
/*
!/frontend
/frontend/*
!/frontend/app
!/frontend/src
!/frontend/assets
!/frontend/constants
!/frontend/plugins
!/frontend/scripts
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/app.config.js
!/frontend/app.json
!/frontend/eas.json
!/frontend/metro.config.js
!/frontend/tsconfig.json
# Defense in depth for any allowed subtree.
**/node_modules/
**/.expo/
**/.metro-cache/
**/.env
**/.env.*
**/*.keystore
**/*.jks
**/*.key
**/*.pem
**/*credentials*.json
**/*token*.json
**/*.log
# Native folders and local signing are intentionally regenerated by managed EAS.
/frontend/android/
/frontend/ios/
